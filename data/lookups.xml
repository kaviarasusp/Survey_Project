<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference lists for the survey builder. Industries, goals and themes are edited on the Settings screen. -->
<lookups>
  <facet code="industry" name="Industry">
    <value code="insurance">Insurance</value>
    <value code="manufacturing">Manufacturing</value>
  </facet>

  <!-- Goals depend on the industry (industry="…") -->
  <facet code="survey_goal" name="Goal">
    <value code="executive_insight" industry="insurance">Executive insight</value>
    <value code="csat_services" industry="insurance">CSAT Services</value>
    <value code="project_health" industry="insurance">Project health report</value>
    <value code="csat" industry="insurance">CSAT</value>
    <value code="product_platform" industry="insurance">Product or Platform</value>
    <value code="product_prelaunch" industry="manufacturing">Product Prelaunch</value>
    <value code="product_launch_opinion" industry="manufacturing">Product Launch opinion</value>
    <value code="distributor" industry="manufacturing">Distributor</value>
  </facet>

  <facet code="audience" name="Audience">
    <value code="cxo" description="CEO, CIO, CTO, COO and other executives">CXO</value>
    <value code="non_cxo" description="Managers, team leads and business users">Non-CXO</value>
  </facet>

  <facet code="theme" name="Theme">
    <value code="ai">AI</value>
    <value code="outsourcing">Outsourcing</value>
  </facet>

  <facet code="dipstick" name="Dip Stick">
    <value code="standard" questions="10" description="Quick check">Standard</value>
    <value code="in_depth" questions="15" description="Adds deeper follow-up questions">In-depth</value>
  </facet>

  <!-- Rating scales: 5-point and 7-point agreement. NPS uses the fixed 0–10 scale. -->
  <scales>
    <scale code="agree_5" favourable="4" name="5-point">
      <point value="1">Strongly disagree</point><point value="2">Disagree</point><point value="3">Neither agree nor disagree</point>
      <point value="4">Agree</point><point value="5">Strongly agree</point>
    </scale>
    <scale code="agree_7" favourable="5" name="7-point">
      <point value="1">Strongly disagree</point><point value="2">Disagree</point><point value="3">Somewhat disagree</point>
      <point value="4">Neither agree nor disagree</point><point value="5">Somewhat agree</point><point value="6">Agree</point>
      <point value="7">Strongly agree</point>
    </scale>
    <scale code="likelihood_11" favourable="9" name="NPS 0–10" locked="true">
      <point value="0">Not at all likely</point><point value="1">1</point><point value="2">2</point><point value="3">3</point>
      <point value="4">4</point><point value="5">5</point><point value="6">6</point><point value="7">7</point>
      <point value="8">8</point><point value="9">9</point><point value="10">Extremely likely</point>
    </scale>
  </scales>
</lookups>
