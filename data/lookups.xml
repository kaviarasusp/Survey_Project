<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference lists for the survey builder. Read-only in the demo; edited by A4U admins in the full product.
     synonyms="a|b" are extra search words for the Question library and Add questions search. -->
<lookups>
  <facet code="industry" name="Industry">
    <value code="insurance" synonyms="insurer|carrier|policy|claims|underwriting|P&amp;C|life and annuity">Insurance</value>
    <value code="manufacturing" synonyms="plant|factory|shop floor|MES|production|supply chain|OEM">Manufacturing</value>
  </facet>

  <!-- Goals depend on the industry (industry="…") -->
  <facet code="survey_goal" name="Goal">
    <value code="executive_insight" industry="insurance" synonyms="leadership|strategy|C-suite|QBR|business review">Executive insight</value>
    <value code="csat_services" industry="insurance" synonyms="service satisfaction|service desk|support|tickets|SLA">CSAT Services</value>
    <value code="project_health" industry="insurance" synonyms="project status|delivery health|schedule|budget|RAG">Project health report</value>
    <value code="csat" industry="insurance" synonyms="customer satisfaction|satisfaction|pulse">CSAT</value>
    <value code="product_platform" industry="insurance" synonyms="platform|product|policy admin|core system|roadmap">Product or Platform</value>
    <value code="product_prelaunch" industry="manufacturing" synonyms="pre-launch|readiness|go-live readiness|launch plan">Product Prelaunch</value>
    <value code="product_launch_opinion" industry="manufacturing" synonyms="post-launch|launch feedback|launch review|adoption">Product Launch opinion</value>
    <value code="distributor" industry="manufacturing" synonyms="dealer|channel partner|reseller|distribution|ordering">Distributor</value>
  </facet>

  <facet code="audience" name="Audience">
    <value code="cxo" description="CEO, CIO, CTO, COO and other executives" synonyms="CXO|C-level|executive|sponsor|leadership|CIO|CTO|CEO">CXO</value>
    <value code="non_cxo" description="Managers, team leads and business users" synonyms="manager|team lead|business user|end user|operations|staff">Non-CXO</value>
  </facet>

  <facet code="theme" name="Theme">
    <value code="ai" synonyms="artificial intelligence|GenAI|generative AI|machine learning|ML|automation|copilot|chatbot|model">AI</value>
    <value code="outsourcing" synonyms="managed services|vendor|supplier|offshore|service levels|SLA|delivery|partner|staffing">Outsourcing</value>
  </facet>

  <facet code="dipstick" name="Dip Stick">
    <value code="standard" questions="10" minutes="5" description="Core questions only">Standard</value>
    <value code="in_depth" questions="18" minutes="12" description="Core questions plus deeper follow-ups">In-depth</value>
  </facet>

  <!-- Rating scales: 5-point and 7-point agreement. NPS uses the fixed 0–10 scale. -->
  <scales>
    <scale code="agree_5" favourable="4" name="5-point">
      <point value="1">Strongly disagree</point><point value="2">Disagree</point><point value="3">Neither agree nor disagree</point>
      <point value="4">Agree</point><point value="5">Strongly agree</point>
    </scale>
    <scale code="agree_7" favourable="5" name="7-point">
      <point value="1">Strongly disagree</point><point value="2">Disagree</point><point value="3">Somewhat disagree</point>
      <point value="4">Neither agree nor disagree</point><point value="5">Somewhat agree</point><point value="6">Agree</point>
      <point value="7">Strongly agree</point>
    </scale>
    <scale code="likelihood_11" favourable="9" name="NPS 0–10" locked="true">
      <point value="0">Not at all likely</point><point value="1">1</point><point value="2">2</point><point value="3">3</point>
      <point value="4">4</point><point value="5">5</point><point value="6">6</point><point value="7">7</point>
      <point value="8">8</point><point value="9">9</point><point value="10">Extremely likely</point>
    </scale>
  </scales>
</lookups>
